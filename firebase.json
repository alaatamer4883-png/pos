{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "extracted/**",
      "data/**",
      "*.zip",
      "*.bat",
      "*.cmd",
      "*.exe",
      "*.dll",
      "*.ps1",
      "server.js",
      "package.json",
      "README.md"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}